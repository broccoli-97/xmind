{
    "$schema": "ymind-theme-v1",
    "id": "builtin.whimsy",
    "name": "Whimsy",
    "description": "Sunset confetti — saturated solid pills on warm peach",
    "nodeStyle": {
        "shape": "roundedRect",
        "borderRadius": 13.0,
        "padding": 7.0,
        "fillMode": "solid",
        "fillAlpha": 1.0,
        "borderWidth": 0.0,
        "borderColorSource": "darker",
        "paletteSource": "branch",
        "drawShadow": false
    },
    "rootStyle": {
        "shape": "none",
        "padding": 18.0,
        "fontFamily": "Georgia",
        "fontPointSize": 22.0
    },
    "edgeStyle": {
        "width": 2.4,
        "colorSource": "branch",
        "anchor": "center",
        "curvature": 0.6,
        "colorModifier": "same",
        "lineCap": "round"
    },
    "backgroundPattern": "dots",
    "colors": {
        "light": {
            "canvasBackground": "#F4E4DA",
            "canvasGridDot": "#E0D5CE",
            "nodePalette": [
                "#E85854",
                "#9D69D2",
                "#E9AB2B",
                "#009ED8",
                "#5BBE62",
                "#E662A8"
            ],
            "nodeShadow": "#00000000",
            "nodeSelectionBorder": "#E85854",
            "nodeText": "#FCFCFC",
            "edgeLightenFactor": 100,
            "exportBackground": "#F4E4DA"
        },
        "dark": {
            "canvasBackground": "#2A241D",
            "canvasGridDot": "#3A3226",
            "nodePalette": [
                "#E85854",
                "#9D69D2",
                "#E9AB2B",
                "#009ED8",
                "#5BBE62",
                "#E662A8"
            ],
            "nodeShadow": "#00000000",
            "nodeSelectionBorder": "#E85854",
            "nodeText": "#FCFCFC",
            "edgeLightenFactor": 100,
            "exportBackground": "#2A241D"
        }
    }
}
