{
    "$schema": "ymind-theme-v1",
    "id": "builtin.sequoia",
    "name": "Sequoia",
    "description": "macOS-style pills — system colors per branch on a neutral canvas",
    "nodeStyle": {
        "shape": "roundedRect",
        "borderRadius": 11.0,
        "padding": 14.0,
        "fillMode": "solid",
        "paletteSource": "branch",
        "borderWidth": 0.0,
        "drawShadow": true,
        "shadowLayers": 3,
        "shadowSpread": 5.0,
        "shadowOffsetY": 2.0,
        "shadowOpacity": 0.9
    },
    "rootStyle": {
        "padding": 18.0,
        "fontPointSize": 15.0
    },
    "edgeStyle": {
        "width": 2.0,
        "colorSource": "branch",
        "anchor": "center",
        "curvature": 0.55,
        "colorModifier": "same",
        "lineCap": "round"
    },
    "backgroundPattern": "none",
    "colors": {
        "light": {
            "canvasBackground": "#F5F5F7",
            "canvasGridDot": "#E5E5EA",
            "nodePalette": [
                "#007AFF",
                "#34C759",
                "#FF9500",
                "#AF52DE",
                "#FF2D55",
                "#30B0C7"
            ],
            "nodeShadow": "#28000000",
            "nodeSelectionBorder": "#1D1D1F",
            "nodeText": "#FFFFFF",
            "edgeLightenFactor": 100,
            "exportBackground": "#F5F5F7"
        },
        "dark": {
            "canvasBackground": "#1E1E1E",
            "canvasGridDot": "#3A3A3C",
            "nodePalette": [
                "#0A84FF",
                "#30D158",
                "#FF9F0A",
                "#BF5AF2",
                "#FF375F",
                "#40C8E0"
            ],
            "nodeShadow": "#46000000",
            "nodeSelectionBorder": "#F5F5F7",
            "nodeText": "#FFFFFF",
            "edgeLightenFactor": 100,
            "exportBackground": "#1E1E1E"
        }
    }
}
