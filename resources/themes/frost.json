{
    "$schema": "ymind-theme-v1",
    "id": "builtin.frost",
    "name": "Frost",
    "description": "Frosted glass tints on a cool gray canvas — macOS materials",
    "nodeStyle": {
        "shape": "roundedRect",
        "borderRadius": 10.0,
        "padding": 14.0,
        "fillMode": "tinted",
        "fillAlpha": 0.14,
        "paletteSource": "branch",
        "textColorSource": "scheme",
        "borderWidth": 1.0,
        "borderColorSource": "fixed",
        "drawShadow": true,
        "shadowLayers": 3,
        "shadowSpread": 4.0,
        "shadowOffsetY": 2.0,
        "shadowOpacity": 0.6
    },
    "rootStyle": {
        "fillAlpha": 0.24,
        "borderWidth": 1.4,
        "padding": 17.0,
        "fontPointSize": 14.0
    },
    "edgeStyle": {
        "width": 2.0,
        "colorSource": "branch",
        "anchor": "center",
        "curvature": 0.55,
        "colorModifier": "same",
        "lineCap": "round"
    },
    "backgroundPattern": "none",
    "colors": {
        "light": {
            "canvasBackground": "#EEF0F4",
            "canvasGridDot": "#12000000",
            "nodePalette": [
                "#007AFF",
                "#34C759",
                "#FF9500",
                "#AF52DE",
                "#FF2D55",
                "#30B0C7"
            ],
            "nodeShadow": "#1E000000",
            "nodeSelectionBorder": "#007AFF",
            "nodeText": "#1D1D1F",
            "nodeBorderColor": "#1A000000",
            "edgeLightenFactor": 100,
            "exportBackground": "#EEF0F4"
        },
        "dark": {
            "canvasBackground": "#1C1C1E",
            "canvasGridDot": "#16FFFFFF",
            "nodePalette": [
                "#0A84FF",
                "#30D158",
                "#FF9F0A",
                "#BF5AF2",
                "#FF375F",
                "#40C8E0"
            ],
            "nodeShadow": "#46000000",
            "nodeSelectionBorder": "#0A84FF",
            "nodeText": "#F5F5F7",
            "nodeBorderColor": "#28FFFFFF",
            "edgeLightenFactor": 100,
            "exportBackground": "#1C1C1E"
        }
    }
}
