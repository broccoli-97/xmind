{
    "$schema": "ymind-theme-v1",
    "id": "builtin.morandi",
    "name": "Morandi",
    "description": "Refined Morandi palette — soft, painterly hues with a clean modern lift",
    "nodeStyle": {
        "shape": "roundedRect",
        "borderRadius": 8.0,
        "padding": 14.0,
        "fillMode": "tinted",
        "fillAlpha": 0.60,
        "borderWidth": 1.4,
        "borderColorSource": "darker",
        "drawShadow": false
    },
    "rootStyle": {
        "fillAlpha": 0.78,
        "borderWidth": 2.0,
        "padding": 16.0
    },
    "edgeStyle": {
        "width": 1.8,
        "colorSource": "target",
        "anchor": "center",
        "curvature": 0.55,
        "colorModifier": "same",
        "lineCap": "round"
    },
    "backgroundPattern": "dots",
    "colors": {
        "light": {
            "canvasBackground": "#F7F3EC",
            "canvasGridDot": "#E8E1D6",
            "nodePalette": [
                "#C7A99A",
                "#A8BFA9",
                "#B5C7D4",
                "#DDC59C",
                "#C5AEC2",
                "#BCC9A8"
            ],
            "nodeShadow": "#00000000",
            "nodeSelectionBorder": "#8C6F58",
            "nodeText": "#3B342E",
            "edgeLightenFactor": 100,
            "exportBackground": "#F7F3EC"
        },
        "dark": {
            "canvasBackground": "#2E2A26",
            "canvasGridDot": "#463F39",
            "nodePalette": [
                "#D2B9A8",
                "#BACCB4",
                "#C5D2DE",
                "#E2CDA4",
                "#CCBCCB",
                "#C5D0BD"
            ],
            "nodeShadow": "#00000000",
            "nodeSelectionBorder": "#EAB78C",
            "nodeText": "#EAE1D6",
            "edgeLightenFactor": 100,
            "exportBackground": "#2E2A26"
        }
    }
}
