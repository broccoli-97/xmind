{
    "$schema": "ymind-template-v1",
    "id": "builtin.lined",
    "name": "Lined",
    "description": "Text floats on continuous baseline-anchored colored lines",
    "layout": {
        "algorithm": "bilateral",
        "depthSpacing": 120.0,
        "spreadSpacing": 22.0
    },
    "overrides": {
        "nodeShape": "underline",
        "rootShape": "underline",
        "edgeAnchor": "baseline",
        "paletteSource": "branch",
        "edgeColorSource": "branch"
    },
    "content": {
        "text": "Mind Mapping",
        "children": [
            {
                "text": "Why Mind Mapping?",
                "children": [
                    {"text": "Disrupting linear thinking"},
                    {"text": "Allows easy reorganization"},
                    {"text": "Helps us think \"radiantly\""}
                ]
            },
            {
                "text": "Main benefits",
                "children": [
                    {"text": "Enables creative thinking"},
                    {"text": "Combats perfectionism"},
                    {"text": "Iterative thinking"}
                ]
            },
            {"text": "Visual thinking"},
            {
                "text": "Helpful for pre-writing",
                "children": [
                    {"text": "Escape the blinking cursor"},
                    {"text": "Healthy ideation strategies"}
                ]
            },
            {
                "text": "How to Mind Map",
                "children": [
                    {"text": "Begin with an idea"},
                    {"text": "Build connections outward"},
                    {"text": "Reorganize as needed"}
                ]
            }
        ]
    }
}
