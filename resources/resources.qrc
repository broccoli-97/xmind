    <qresource prefix="/templates">
        <file alias="mindmap.json">templates/mindmap.json</file>
        <file alias="orgchart.json">templates/orgchart.json</file>
        <file alias="projectplan.json">templates/projectplan.json</file>
        <file alias="lined.json">templates/lined.json</file>
        <file alias="outlined.json">templates/outlined.json</file>
        <file alias="tinted.json">templates/tinted.json</file>
    </qresource>
</RCC>
