<RCC>
    <qresource prefix="/styles">
        <file alias="theme.qss">theme.qss</file>
    </qresource>
    <qresource prefix="/templates">
        <file alias="mindmap.json">templates/mindmap.json</file>
        <file alias="orgchart.json">templates/orgchart.json</file>
        <file alias="projectplan.json">templates/projectplan.json</file>
        <file alias="lined.json">templates/lined.json</file>
    </qresource>
    <qresource prefix="/themes">
        <file alias="default.json">themes/default.json</file>
        <file alias="morandi.json">themes/morandi.json</file>
        <file alias="nord.json">themes/nord.json</file>
        <file alias="sakura.json">themes/sakura.json</file>
        <file alias="forest.json">themes/forest.json</file>
        <file alias="candy.json">themes/candy.json</file>
        <file alias="outlined.json">themes/outlined.json</file>
        <file alias="tinted.json">themes/tinted.json</file>
    </qresource>
</RCC>
